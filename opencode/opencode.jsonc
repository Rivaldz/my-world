{
  "$schema": "https://opencode.ai/config.json",
  "model": "sumopod/deepseek-v4-flash",
  "small_model": "sumopod/qwen3.7-flash-2026-07-15",
  "enabled_providers": [
    "sumopod"
  ],
  "agent": {
    "plan": {
      "model": "sumopod/deepseek-v4-pro"
    }
  },
  "provider": {
    "sumopod": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SumoPod AI API",
      "options": {
        "baseURL": "https://ai.sumopod.com/v1",
        "apiKey": "{env:SUMODOP_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "Deepseek V4 Flash (SumoPod)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        "deepseek-v4-pro": {
          "name": "Deepseek V4 Pro (SumoPod)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        "MiniMax-M2.7-highspeed": {
          "name": "MiniMax M2.7 Highspeed (SumoPod)",
          "limit": {
            "context": 204800,
            "output": 8192
          }
        },
        "qwen3.7-flash-2026-07-15": {
          "name": "Qwen3.7 Flash 2026-07-15 (SumoPod)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    }
  }
}
